# Entorno local con Mailpit: docker compose --profile dev up --build
PORTFOLIO_PORT=8081
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
CONTACT_SENDER=jgfestudios@gmail.com
CONTACT_RECIPIENT=jgfestudios@gmail.com

# Para Gmail SMTP en un entorno privado, usa smtp.gmail.com:587,
# MAIL_USERNAME=jgfestudios@gmail.com, una contraseña de aplicación
# en MAIL_PASSWORD, y auth/starttls=true. Nunca subas el archivo .env.
