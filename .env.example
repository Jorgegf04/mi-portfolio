# Correo real con Gmail. Copia este archivo a .env y configura MAIL_PASSWORD.
PORTFOLIO_PORT=8081
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=jgfestudios@gmail.com
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
CONTACT_SENDER=jgfestudios@gmail.com
CONTACT_RECIPIENT=jgfestudios@gmail.com

# Pruebas locales con Mailpit: define DEV_MAIL_HOST=mailpit y
# DEV_MAIL_PORT=1025, y arranca Docker Compose con --profile dev.
# Nunca guardes contraseñas reales en este archivo de ejemplo.
DEV_MAIL_HOST=mailpit
DEV_MAIL_PORT=1025
